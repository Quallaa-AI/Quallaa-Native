{
  "name": "@quallaa/domain-core",
  "version": "1.0.0",
  "description": "Core domain abstraction for Quallaa AI-modifiable domains",
  "main": "lib/common/index.js",
  "typings": "lib/common/index.d.ts",
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@theia/core": "1.65.0",
    "@theia/filesystem": "1.65.0",
    "@theia/workspace": "1.65.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/domain-frontend-module"
    }
  ],
  "keywords": [
    "theia-extension",
    "quallaa",
    "domain-abstraction"
  ],
  "license": "EPL-2.0 OR GPL-2.0-only WITH Classpath-exception-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/eclipse-theia/theia.git"
  },
  "bugs": {
    "url": "https://github.com/eclipse-theia/theia/issues"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "theiaext build && npm run copy:css",
    "clean": "theiaext clean",
    "compile": "theiaext compile && npm run copy:css",
    "copy:css": "cp -r src/browser/widgets/*.css lib/browser/widgets/ 2>/dev/null || true && cp -r src/browser/dialogs/*.css lib/browser/dialogs/ 2>/dev/null || true",
    "lint": "theiaext lint",
    "test": "theiaext test",
    "watch": "theiaext watch"
  },
  "devDependencies": {
    "@theia/ext-scripts": "1.65.0"
  },
  "nyc": {
    "extends": "../../configs/nyc.json"
  }
}
